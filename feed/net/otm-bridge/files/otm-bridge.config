config otm-bridge 'main'
	option enabled '1'
	# Monitor interface; created by /usr/libexec/otm-bridge-run.
	option iface 'mon0'
	# Radio to use. Empty: the first phy that offers 'freq' (after the
	# regulatory domain below is set).
	option phy ''
	# EU ITS-G5 CCH = 5900 MHz / channel 180. SCH options: 5880/5890/5910 etc.
	option freq '5900'
	option bw '10MHz'
	# Regulatory domain; needs the patched wireless-regdb (ITS rule).
	option country 'DE'
	# Weg zum Broker (option transport, Vorgabe aus dem Bau):
	#   proxy  - MQTT ohne TLS durch den Management-Tunnel (otm-mgmt-vpn) an
	#            den Proxy auf wgiot6.ffdus.de, der per TLS an cits1 weiterreicht
	#   direct - mqtts direkt an cits1; braucht TLS und CA-Bundle im Image
	#   auto   - Tunnel, wenn er binnen 2 min steht, sonst direkt; nach 10 min
	#            ohne Verbindung beginnt die Wahl von vorn
	# option transport 'proxy'
	option broker_proxy 'mqtt://10.66.0.1'
	option broker_direct 'mqtts://cits1.opentrafficmap.org'
	# Fester Broker, uebergeht transport:
	# option broker 'mqtts://cits1.opentrafficmap.org'
	# Leave empty for <board short name>-<last 4 hex of the monitor MAC>,
	# e.g. WR4300-902f (table in /usr/libexec/otm-bridge-run).
	option node ''
	# 0=quiet, 1=log per 100 packets, 2=debug
	option verbose '1'

	# Local pcap ring in tmpfs (needs tcpdump): capture_files x capture_size
	# MB, oldest file overwritten. Off by default, RAM is scarce on small
	# boards.
	option capture '0'
	option capture_dir '/tmp'
	option capture_size '1'   # MB per file
	option capture_files '5'  # ring length
