#!/bin/sh
# /usr/libexec/otm-bridge-run - runs as the procd instance "bridge".
#
# Sets the regulatory domain, finds the radio that offers the ITS frequency,
# (re)creates the monitor vif, picks the way to the broker (tunnel or
# direct, see option transport), waits for it and execs otm-bridge. Because
# procd respawns this wrapper and not the daemon alone, a vanished monitor
# interface (wifi reload, driver reset) is rebuilt on the next respawn.

. /lib/functions.sh
. /lib/otm-bridge/functions.sh

log() { logger -t otm-bridge "$*"; }

# phy offers freq and it is not disabled by regulatory rules
freq_ok() {
	iw phy "$1" info 2>/dev/null | grep -E "\* $2(\.0)? MHz" | grep -qv disabled
}

# configured phy first, otherwise the first one that offers freq
find_phy() {
	local p
	[ -n "$1" ] && freq_ok "$1" "$2" && { echo "$1"; return 0; }
	for p in /sys/class/ieee80211/*; do
		p=${p##*/}
		freq_ok "$p" "$2" && { echo "$p"; return 0; }
	done
	return 1
}

config_load otm-bridge
config_get iface    main iface    mon0
config_get phy      main phy      ''
config_get freq     main freq     5900
config_get bw       main bw       10MHz
config_get country  main country  DE
config_get broker   main broker   ''
config_get transport main transport proxy
config_get broker_proxy  main broker_proxy  'mqtt://10.66.0.1'
config_get broker_direct main broker_direct 'mqtts://cits1.opentrafficmap.org'
config_get timefile main timefile /var/state/otm-bridge-time
config_get node     main node     ''
config_get verbose  main verbose  1
config_get share_location location share_location 0
config_get latitude  location latitude  ''
config_get longitude location longitude ''
config_get altitude  location altitude  ''

# 5850-5925 MHz only exist in the patched regdb entry for $country; after
# boot the global domain is 00. The change is applied asynchronously, so
# poll, and repeat the request now and then in case something reset it.
iw reg set "$country"
i=0
until p=$(find_phy "$phy" "$freq"); do
	i=$((i + 1))
	if [ $i -ge 30 ]; then
		log "no radio offers $freq MHz (wanted country $country, have $(iw reg get | awk '/^country/ { print $2; exit }'))"
		exit 1
	fi
	[ $((i % 10)) -eq 0 ] && iw reg set "$country"
	sleep 1
done
[ -n "$phy" ] && [ "$p" != "$phy" ] && log "phy $phy does not offer $freq MHz, using $p"

iw dev "$iface" del 2>/dev/null
iw phy "$p" interface add "$iface" type monitor flags otherbss &&
	ip link set "$iface" up &&
	iw dev "$iface" set freq "$freq" "$bw" || {
		log "monitor bring-up failed (iface=$iface phy=$p freq=$freq bw=$bw)"
		exit 1
	}
log "$iface on $p: $(iw dev "$iface" info | awk '/channel/ { sub(/^[ \t]+/, ""); print; exit }')"

# WLAN LED of this radio blinks per received frame instead of throughput
for l in /sys/class/leds/*; do
	grep -q "\[${p}tpt\]" "$l/trigger" 2>/dev/null && echo "${p}rx" > "$l/trigger"
done

# Node id, unless set in uci: <board short name>-<last 4 hex digits of the
# monitor interface MAC>, e.g. WR4300-902f. Same as the hostname.
[ -n "$node" ] || node=$(otm_node_name "$(cat "/sys/class/net/$iface/address")")

# Broker erreichbar ohne Umweg ueber das Standard-Gateway, d. h. der Tunnel
# steht (vorher ginge der erste Verbindungsaufbau ueber die Default-Route
# ins Leere und haengt minutenlang)
direkt_erreichbar() {
	local h=${1#*://}
	h=${h%%/*}; h=${h%%:*}
	case "$(ip route get "$h" 2>/dev/null)" in
	""|*" via "*) return 1 ;;
	esac
}
warte_tunnel() {
	local i=0
	while ! direkt_erreichbar "$broker_proxy"; do
		[ $i -ge "$1" ] && return 1
		sleep 2
		i=$((i + 2))
	done
}
# TLS braucht eine gestellte Uhr. Der ntp-Hotplug legt $timefile an, sobald
# ntpd synchron ist. Hoechstens 120 s warten, dann trotzdem starten; direkt
# nach dem Sync kann der Uhrsprung noch laufen, daher die Nachfrist (5 s
# reichten an der 3390 nicht, 15 s schon).
warte_ntp() {
	local i=0
	while [ ! -e "$timefile" ] && [ $i -lt 120 ]; do
		sleep 2
		i=$((i + 2))
	done
	if [ ! -e "$timefile" ]; then
		log "no NTP sync after 120 s, starting anyway"
	elif [ $(( $(date +%s) - $(date -r "$timefile" +%s) )) -lt 30 ]; then
		sleep 15
	fi
}
tls_da() { [ -s /etc/ssl/certs/ca-certificates.crt ]; }

aufgeben=""
if [ -z "$broker" ]; then
	case "$transport" in
	direct)
		broker=$broker_direct ;;
	auto)
		if warte_tunnel 120 || ! tls_da; then
			broker=$broker_proxy
		else
			broker=$broker_direct
		fi
		aufgeben=600 ;;
	*)
		warte_tunnel 120 || log "no tunnel to $broker_proxy after 120 s, starting anyway"
		broker=$broker_proxy ;;
	esac
fi
case "$broker" in mqtts://*) warte_ntp ;; esac
log "transport $transport, broker $broker"

set -- -f -i "$iface" -b "$broker"
[ -n "$aufgeben" ] && set -- "$@" -x "$aufgeben"
[ -n "$node" ] && set -- "$@" -n "$node"
# Build-Nummer fuer die Statistik, nur an unseren Proxy (otm/<node>/build)
case "$broker" in mqtt://*)
	v=$(sed -n 's/^version=//p' /etc/otm-build-info 2>/dev/null)
	c=$(sed -n 's/^otm_commit=//p' /etc/otm-build-info 2>/dev/null)
	[ -n "$v" ] && set -- "$@" -V "$v" -G "$c"
	# Position: leer = eine frueher gemeldete wieder loeschen
	loc=""
	case "$share_location" in 1|on|true|yes)
		loc=$(otm_location "$latitude" "$longitude" "$altitude") ||
			log "location not shared: latitude/longitude invalid ('$latitude', '$longitude')" ;;
	esac
	set -- "$@" -L "$loc" ;;
esac
[ "$verbose" -ge 1 ] 2>/dev/null && set -- "$@" -v
[ "$verbose" -ge 2 ] 2>/dev/null && set -- "$@" -v
exec /usr/bin/otm-bridge "$@"
