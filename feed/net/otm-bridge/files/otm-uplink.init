#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=10

# WLAN-Rueckfall (siehe /usr/libexec/otm-uplink); nur auf Geraeten mit
# eigenem 2.4-GHz-Radio neben dem ITS-Radio.

start_service() {
	local enabled freq
	. /lib/otm-bridge/functions.sh
	otm_configmode && return 0
	config_load otm-bridge
	config_get_bool enabled uplink wlan_fallback 1
	[ "$enabled" = 1 ] || return 0
	config_get freq main freq 5900
	otm_24_phy "$freq" >/dev/null || return 0

	procd_open_instance uplink
	procd_set_param command /usr/libexec/otm-uplink
	procd_set_param respawn 3600 10 0
	procd_set_param file /etc/config/otm-bridge
	procd_close_instance
}

stop_service() {
	ifdown wwan 2>/dev/null
	iw dev wlan24 del 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "otm-bridge"
}
