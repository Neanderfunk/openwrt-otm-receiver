#!/bin/sh
# /etc/uci-defaults/99-otm-setup
#
# Runs once on first boot (OpenWrt deletes the script after success).
# Provisions a fresh image as an opentrafficmap.org 802.11p receiver:
#   - every Ethernet port is a DHCP client (IPv4 + IPv6), plug in anywhere;
#     plus 169.254.1.1/16 as a fallback where no DHCP server is present:
#     all LAN ports and the WAN port go into one bridge, interface "wan",
#     so the stock wan firewall zone applies; no DHCP/RA server on the box
#   - if an SSH key is baked in: SSH allowed from that zone, key only;
#     without a key SSH stays closed
#   - netifd leaves the radios alone (an enabled radio deletes every vif it
#     did not create itself, i.e. our monitor interface)
#   - hostname = MQTT node id (<board>-<last 4 MAC hex>), e.g. WR4300-902f
#
# Idempotent.

. /lib/functions.sh

# --- Network: all ports -> one DHCP client ---------------------------------

br=$(uci -q show network | sed -n "s/^network\.\([^.=]*\)\.name='br-lan'$/\1/p" | head -n 1)
if [ -n "$br" ]; then
	ports=$(uci -q get network.$br.ports)
else
	ports=$(uci -q get network.lan.device)	# single-port boards
fi

wan_dev=$(uci -q get network.wan.device)
case "$wan_dev" in
	""|br-lan|dsl*|ptm*|atm*|@*) ;;	# no Ethernet WAN (e.g. FRITZ!Box 3390 DSL)
	*) list_contains ports "$wan_dev" || ports="$ports $wan_dev" ;;
esac
ports=$(echo $ports)

# NanoStation M XW (Switch AR8236): eth0.1 und eth0.2 zusammen in einer Bridge
# vertraegt er nicht (bmx6 #439; bei uns keine DHCP-Adresse), und ohne VLANs
# (enable_vlan=0, roh eth0, 0.18.7) haengt der Sendepfad (eth0: tx timeout,
# Test 21.10.2026). Deshalb wie Stock-OpenWrt mit VLANs, aber nur VLAN 1 mit
# beiden Buchsen: CPU tagged, Port 1 und Port 5 untagged; nur eth0.1.
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
ubnt,nanostation-m-xw)
	while uci -q delete network.@switch_vlan[0]; do :; done
	for v in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=switch$/\1/p"); do
		uci set network.$v.enable_vlan='1'
	done
	v=$(uci add network switch_vlan)
	uci set network.$v.device='switch0'
	uci set network.$v.vlan='1'
	uci set network.$v.ports='0t 1 5'
	ports=eth0.1
	;;
esac

set -- $ports
if [ $# -gt 1 ] || [ -n "$br" ]; then
	if [ -z "$br" ]; then
		br=$(uci add network device)
		uci set network.$br.name='br-lan'
		uci set network.$br.type='bridge'
	fi
	uci -q delete network.$br.ports
	for p in $ports; do
		uci add_list network.$br.ports="$p"
	done
	# two ports on the same LAN must not become a loop
	uci set network.$br.stp='1'
	dev=br-lan
else
	dev=$ports
fi

uci -q delete network.lan
uci -q delete network.wan
uci -q delete network.wan6
uci -q delete network.fallback
uci set network.wan=interface
uci set network.wan.device="$dev"
uci set network.wan.proto='dhcp'
uci set network.wan.peerdns='1'
uci set network.wan6=interface
uci set network.wan6.device="$dev"
uci set network.wan6.proto='dhcpv6'
uci set network.wan6.reqprefix='no'
# Rueckfalladresse, falls am Aufstellort (noch) kein DHCP-Server laeuft:
# IPv4-Link-Local kollidiert mit keinem fremden Netz, und ein Rechner mit
# Link-Local-Adresse erreicht das Geraet ohne Vorwissen.
uci set network.fallback=interface
uci set network.fallback.device="$dev"
uci set network.fallback.proto='static'
uci set network.fallback.ipaddr='169.254.1.1'
uci set network.fallback.netmask='255.255.0.0'
uci commit network

# no servers on the uplink, even if dnsmasq/odhcpd are in the image
uci -q get dhcp.lan >/dev/null && {
	uci -q delete dhcp.lan
	uci commit dhcp
}

# --- SSH: only with a key ---------------------------------------------------
# Fresh OpenWrt lets root in without a password. With every port in the wan
# zone, opening SSH without a key would hand the box to the uplink network,
# so without a key it stays closed (the receiver works anyway; failsafe mode
# remains for local access).

. /lib/otm-bridge/functions.sh
otm_ssh_setup

# beide Interfaces in die wan-Zone, sonst greift fuer fallback die Default-Policy
zone=$(uci -q show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -n 1)
if [ -n "$zone" ] && ! uci -q get firewall.$zone.network | grep -q fallback; then
	uci add_list firewall.$zone.network='fallback'
	uci commit firewall
fi

# --- Radios: owned by otm-bridge, not by netifd ----------------------------

for r in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci set wireless.$r.disabled='1'
done
uci -q commit wireless

# --- Paketquellen per http ------------------------------------------------
# Images ohne TLS (transport proxy) haben kein CA-Bundle. Die Pakete sind
# signiert, apk/opkg pruefen die Signatur unabhaengig vom Transport.
if [ ! -s /etc/ssl/certs/ca-certificates.crt ]; then
	for f in /etc/apk/repositories.d/distfeeds.list /etc/opkg/distfeeds.conf; do
		[ -f "$f" ] && sed -i 's#https://#http://#' "$f"
	done
fi

# --- Hostname = MQTT node id, e.g. WR4300-902f ------------------------------
# Tells receivers apart in the DHCP server's lease list at a glance.

. /lib/otm-bridge/functions.sh
freq=$(uci -q get otm-bridge.main.freq)
phy=$(otm_its_phy "${freq:-5900}")
if [ -n "$phy" ]; then
	name=$(otm_node_name "$(cat /sys/class/ieee80211/$phy/macaddress)")
else
	# kein ITS-Funkteil (z. B. NanoStation M2): Name wie die Problem-Meldung in
	# otm-bridge-run, aus dem ersten Funkteil bzw. eth0 (frueher "opentrafficmap")
	mac=$(cat /sys/class/ieee80211/*/macaddress 2>/dev/null | head -n 1)
	[ -n "$mac" ] || mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
	name=$(otm_node_name "$mac")
fi
uci set system.@system[0].hostname="$name"
uci commit system

# --- Alte Konfiguration: fester Broker = Proxy ist seit option transport -----
# ueberfluessig und uebergeht die Wegwahl
if [ "$(uci -q get otm-bridge.main.broker)" = "mqtt://10.66.0.1" ]; then
	uci delete otm-bridge.main.broker
	uci commit otm-bridge
fi

# --- WLAN-Rueckfall: Interface wwan (2.4-GHz-Client, von otm-uplink gesteuert)
if ! uci -q get otm-bridge.uplink >/dev/null; then
	uci set otm-bridge.uplink=uplink
	uci set otm-bridge.uplink.wlan_fallback=1
	uci set otm-bridge.uplink.ssid_prefix='Freifunk'
	uci set otm-bridge.uplink.lan_timeout=90
	uci set otm-bridge.uplink.wlan_timeout=60
	uci commit otm-bridge
fi
uci set network.wwan=interface
uci set network.wwan.device='wlan24'
uci set network.wwan.proto='dhcp'
uci set network.wwan.auto='0'
uci set network.wwan.metric='50'
uci commit network
for z in $(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='wan'\$/\1/p"); do
	uci -q get firewall.$z.network | grep -qw wwan || uci add_list firewall.$z.network='wwan'
done
uci commit firewall

# --- Position (wie Gluon), auch nach Update mit alter Konfiguration ---------
if ! uci -q get otm-bridge.location >/dev/null; then
	uci set otm-bridge.location=location
	uci set otm-bridge.location.share_location=0
	uci set otm-bridge.location.latitude=''
	uci set otm-bridge.location.longitude=''
	uci set otm-bridge.location.altitude=''
	uci commit otm-bridge
fi

# --- /etc/profile.d: unsere Dateien aus dem neuen Image ------------------
# sysupgrade nimmt das ganze Verzeichnis mit (keep.d/base-files), die alten
# Kopien ueberdeckten sonst bei jedem Update die neuen aus dem Image
# (Login-Hinweis otm.sh, stillgelegte root-Passwort-Warnung).
for f in otm.sh 00-passwordless-root.sh; do
	[ -f /rom/etc/profile.d/$f ] || continue
	cmp -s /rom/etc/profile.d/$f /etc/profile.d/$f || cp /rom/etc/profile.d/$f /etc/profile.d/$f
done

exit 0
