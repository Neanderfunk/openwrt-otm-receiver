#!/bin/sh /etc/rc.common
# Config-Mode, zweiter Teil (nach Firewall, dropbear, fastd): wie Gluon
# dropbear mit leerem root-Passwort (-B), DHCP-Server fuer 192.168.1.0/24
# (S60dnsmasq) und blinkende Status-LED (S96led). Firewall und Tunnel aus;
# otm-bridge, otm-uplink und der Autoupdater pruefen den Merker selbst.

START=96
USE_PROCD=1

SETUP_MODE_DHCP_RANGE=192.168.1.2,192.168.1.254

start_service() {
	. /lib/otm-bridge/functions.sh
	otm_configmode || return 0

	/etc/init.d/fastd stop 2>/dev/null
	/etc/init.d/firewall stop 2>/dev/null
	/etc/init.d/dropbear stop 2>/dev/null

	procd_open_instance ssh
	procd_set_param command /usr/sbin/dropbear -F -B -R
	procd_set_param respawn
	procd_close_instance

	procd_open_instance dhcp
	procd_set_param command /usr/sbin/dnsmasq -k -p 0 -F $SETUP_MODE_DHCP_RANGE -l /tmp/dhcp.leases -O option:router
	procd_set_param respawn
	procd_close_instance

	(
		. /etc/diag.sh
		get_status_led 2> /dev/null
		[ -z "$status_led" ] && status_led="$running"
		[ -z "$status_led" ] && status_led="$boot"
		[ -n "$status_led" ] && status_led_set_timer 1000 300
	)
}
