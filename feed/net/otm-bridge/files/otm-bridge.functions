# /lib/otm-bridge/functions.sh - shared by otm-bridge-run and 99-otm-setup,
# so the MQTT node id and the hostname (DHCP) are built the same way.

# Nur 2.4 GHz: es gibt Funkteile, aber keines mit 5-GHz-Band (Band 2), z. B.
# NanoStation M2 mit dem M-Image, das wegen gleichen Board-Namens auch passt
otm_nur_24() {
	local p n=0
	for p in /sys/class/ieee80211/*; do
		[ -e "$p" ] || continue
		n=1
		iw phy "${p##*/}" info 2>/dev/null | grep -q "Band 2:" && return 1
	done
	[ $n = 1 ]
}

# Short board name for node id and hostname. Ubiquiti-M-Geraete ohne 5-GHz-
# Funkteil heissen M2 statt M5 (gleicher Board-Name, z. B. NSM2XM statt NSM5XM).
otm_board_short() {
	local s
	s=$(otm_board_short_raw)
	case "$s" in *M5*) otm_nur_24 && s=$(echo "$s" | sed 's/M5/M2/') ;; esac
	echo "$s"
}

otm_board_short_raw() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	tplink,tl-wdr4300-v1*)		echo WR4300 ;;
	tplink,tl-wdr3600-v1)		echo WR3600 ;;
	tplink,tl-wdr4900-v*)		echo WR4900 ;;
	buffalo,wzr-hp-ag300h)		echo AG300H ;;
	buffalo,wzr-600dhp)		echo WZR600 ;;
	avm,fritz3390)			echo FB3390 ;;
	ubnt,nanostation-m-xw)		echo NSM5XW ;;
	ubnt,nanostation-m)		echo NSM5XM ;;
	ubnt,nanostation-loco-m-xw)	echo NSLM5XW ;;
	ubnt,nanostation-loco-m)	echo NSLM5XM ;;
	ubnt,litebeam-m5-xw)		echo LBEM5 ;;
	ubnt,bullet-m*)			echo BM5 ;;
	ubnt,rocket-m*)			echo RM5 ;;
	ubnt,powerbridge-m)		echo PBRM5 ;;
	ubnt,powerbeam-m5-xw)		echo PBM5XW ;;
	tplink,cpe510-v*)		echo CPE510 ;;
	*)	# fallback: first word of the model with a digit, vendor prefix off
		awk '{ for (i = 1; i <= NF; i++) if ($i ~ /[0-9]/) { sub(/^TL-/, "", $i); print $i; exit } }' \
			/tmp/sysinfo/model 2>/dev/null | tr -cd 'A-Za-z0-9' ;;
	esac
}

# <board short name>-<last 4 hex digits of mac, lowercase>, e.g. WR4300-902f
otm_node_name() {
	local mac short
	mac=$(echo "$1" | tr -d ':\n' | tr 'A-F' 'a-f')
	short=$(otm_board_short)
	echo "${short:-OpenWrt}-${mac#${mac%????}}"
}

# First phy that knows freq at all (also while regulatory still disables it,
# e.g. at first boot before the regdomain is set).
otm_its_phy() {
	local p
	for p in /sys/class/ieee80211/*; do
		p=${p##*/}
		iw phy "$p" info 2>/dev/null | grep -qE "\* $1(\.0)? MHz" && { echo "$p"; return 0; }
	done
	return 1
}

# Position fuer otm/<node>/location: "lat,lon[,alt]" in Dezimalgrad, auf
# 6 Nachkommastellen (~0.1 m). Nimmt Komma oder Punkt, Leerzeichen und ein
# vorangestelltes "+". Ungueltig, ausserhalb des Bereichs oder 0/0: Status 1.
otm_location() {
	local lat lon alt
	lat=$(echo "$1" | tr ',' '.' | tr -d ' +')
	lon=$(echo "$2" | tr ',' '.' | tr -d ' +')
	alt=$(echo "$3" | tr ',' '.' | tr -d ' +')
	awk -v a="$lat" -v o="$lon" -v h="$alt" 'BEGIN {
		num = "^-?[0-9]+(\\.[0-9]+)?$"
		if (a !~ num || o !~ num || (h != "" && h !~ num)) exit 1
		if (a < -90 || a > 90 || o < -180 || o > 180 || (a == 0 && o == 0)) exit 1
		s = sprintf("%.6f,%.6f", a, o)
		if (h != "") s = s sprintf(",%.1f", h)
		print s
	}'
}

# Eigenes 2.4-GHz-Radio neben dem ITS-Radio (Doppelband-Geraete), sonst Status 1
otm_24_phy() {
	local p its
	its=$(otm_its_phy "${1:-5900}")
	for p in /sys/class/ieee80211/*; do
		p=${p##*/}
		[ "$p" = "$its" ] && continue
		iw phy "$p" info 2>/dev/null | grep -q "Band 1:" && { echo "$p"; return 0; }
	done
	return 1
}

# SSH nach Keys einrichten (99-otm-setup, jeder Start im Normalbetrieb ueber
# otm-configmode-early, otm-configmode exit): mit Key in
# /etc/dropbear/authorized_keys laeuft dropbear, nur per Key, und die
# wan-Zone laesst Port 22 zu; ohne Key bleibt SSH zu. Schreibt nur, was sich
# aendert (laeuft bei jedem Start, kein Flash-Schreiben im Normalfall).
otm_ssh_setup() {
	local has_key=0 sec o
	grep -q '^ssh-\|^ecdsa-' /etc/dropbear/authorized_keys 2>/dev/null && has_key=1
	for o in PasswordAuth RootPasswordAuth; do
		[ "$(uci -q get dropbear.@dropbear[0].$o)" = off ] || uci set dropbear.@dropbear[0].$o='off'
	done
	[ -n "$(uci -q changes dropbear)" ] && uci commit dropbear
	if [ $has_key = 1 ]; then
		# rcS hat die Liste der Start-Skripte schon gelesen: neu
		# eingeschaltet also gleich starten, sonst erst beim naechsten Start
		/etc/init.d/dropbear enabled || {
			/etc/init.d/dropbear enable
			/etc/init.d/dropbear start
		}
	else
		/etc/init.d/dropbear enabled && /etc/init.d/dropbear disable
		/etc/init.d/dropbear stop 2>/dev/null
	fi
	if [ $has_key = 1 ] && ! uci -q show firewall | grep -q "name='Allow-SSH-WAN'"; then
		sec=$(uci add firewall rule)
		uci set "firewall.${sec}.name=Allow-SSH-WAN"
		uci set "firewall.${sec}.src=wan"
		uci set "firewall.${sec}.proto=tcp"
		uci set "firewall.${sec}.dest_port=22"
		uci set "firewall.${sec}.target=ACCEPT"
		uci commit firewall
	fi
	return 0
}

# Laeuft das Geraet gerade im Config-Mode? (Merker in tmpfs, gesetzt beim Start)
otm_configmode() {
	[ -e /var/run/otm-configmode ]
}
