#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

# The bridge instance is a wrapper that sets up regdomain, radio and monitor
# vif itself (/usr/libexec/otm-bridge-run), so start_service never blocks the
# boot and every respawn rebuilds the monitor interface.

start_service() {
	local enabled iface capture capture_dir capture_size capture_files tcpdump

	config_load otm-bridge
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	procd_open_instance bridge
	procd_set_param command /usr/libexec/otm-bridge-run
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/otm-bridge
	procd_close_instance

	# Optional local mirror into tmpfs. -C/-W without -G: tcpdump ignores
	# -W as soon as -G is given too, and the "ring" then grows without bound.
	config_get_bool capture main capture 0
	[ "$capture" = "1" ] || return 0
	tcpdump=$(command -v tcpdump) || {
		logger -t otm-bridge "capture=1, but tcpdump is not installed"
		return 0
	}
	config_get iface         main iface         mon0
	config_get capture_dir   main capture_dir   /tmp
	config_get capture_size  main capture_size  1
	config_get capture_files main capture_files 5
	mkdir -p "$capture_dir"

	# Until the bridge instance has created $iface, tcpdump exits and procd
	# retries every 10 s.
	procd_open_instance sniffer
	procd_set_param command "$tcpdump" -i "$iface" -n -s 0 -U \
		-w "$capture_dir/$iface.pcap" -C "$capture_size" -W "$capture_files"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local iface l t

	config_load otm-bridge
	config_get iface main iface mon0
	for l in /sys/class/leds/*; do
		t=$(sed -n 's/.*\[\(phy[0-9]*\)rx\].*/\1tpt/p' "$l/trigger" 2>/dev/null)
		[ -n "$t" ] && echo "$t" > "$l/trigger"
	done
	iw dev "$iface" del 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "otm-bridge"
}
