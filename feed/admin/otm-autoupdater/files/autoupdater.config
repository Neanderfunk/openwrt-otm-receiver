# Autoupdater der OTM-Empfaenger. Manifest und Signaturen wie bei Gluon
# (sign.sh/ecdsasign), Schluessel aus FirmwareConfigs buildkeys/ffnef.signkeys.
config autoupdater 'settings'
	option enabled '1'
	option branch 'stable'

config branch 'stable'
	option name 'stable'
	list mirror 'http://firmware.ffnef.de/otm/stable/sysupgrade'
	option good_signatures '3'
	list pubkey '2a61930930a240c027f6ca4197203d400b6e4a32f9e92041e5f086907796c9bc' # adorfer
	list pubkey 'd02f8e60fb7a5069556500694ebe512b6017b01e9950476e4cfcf10d5130c296' # JJX
	list pubkey '96d644ff1ce07d6f67d9329a0eb9a1548d0d01a3519d17ec1fe9d49da3270bfc' # plaste
	list pubkey 'cd97b5e735cdefb1da4aede68f127c8c2f4536df6f544b568df5c801b88a9225' # alex
	list pubkey 'bd9e2ec7c5a1d420ff31543f27e02576b01ba5c887e726ab9388a25853b7d623' # untrustworthy-buildbot
