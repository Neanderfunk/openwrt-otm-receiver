{
 "uid": "otm-empfang",
 "title": "OTM Empfang",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "ITS-Frames je Empfaenger pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_frames[1h]))",
     "legendFormat": "{{node}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_union_frames[1h]))",
     "legendFormat": "alle zusammen (verschiedene)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "ITS-G5-Frames (GeoNetworking), die jeder Empfänger in der jeweils letzten Stunde an den Proxy gemeldet hat. 'alle zusammen' zählt jeden Frame nur einmal, auch wenn ihn mehrere Empfänger hatten; doppelte erkennt otm-stats an Absender-MAC, Sequenznummer und Inhaltsanfang innerhalb von 5 Sekunden. Nachts ist auf der Straße kaum Verkehr."
  },
  {
   "id": 2,
   "title": "Nur von diesem Empfaenger gesehen, pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_exclusive[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Frames, die kein anderer unserer Empfänger hatte. Das ist der eigene Beitrag eines Standorts zur Abdeckung; ein Empfänger mit vielen Frames, aber kaum exklusiven, hört dieselben Sender wie die anderen."
  },
  {
   "id": 3,
   "title": "Frames nach Zahl der Empfaenger, pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (n) (increase(otm_receivers_n[1h]))",
     "legendFormat": "{{n}} Empfaenger"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Wie viele unserer Empfänger denselben Frame hatten: n=1 nur einer, n=2 zwei usw. Viel Überlappung heißt, die Standorte hören dieselben Sender."
  },
  {
   "id": 4,
   "title": "Anteil an allen Frames (24 h gleitend)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_frames[24h])) / scalar(sum(increase(otm_union_frames[24h])))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Anteil der verschiedenen Frames der letzten 24 Stunden, den dieser Empfänger hatte (1 = alle, die irgendeiner unserer Empfänger hatte)."
  },
  {
   "id": 5,
   "title": "Verschiedene Absender je Minute",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "otm_union_stations",
     "legendFormat": "Absender"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Zahl der verschiedenen Absender-MAC-Adressen je Minute über alle Empfänger. ITS-Stationen wechseln ihre MAC-Adresse von Zeit zu Zeit (Pseudonyme), die Zahl ist also eine Obergrenze für die Fahrzeuge."
  },
  {
   "id": 6,
   "title": "Online",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "otm_node_online",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "online",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "offline",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "legend": {
     "showLegend": false
    }
   },
   "description": "Grün = online, rot = offline. Grundlage ist die retained Statusmeldung jedes Empfängers am Proxy; 'offline' setzt der Broker, wenn die Verbindung abreißt (Last Will). Stationen, die länger als 24 Stunden offline sind, schreibt otm-stats nicht mehr fort: Sie verschwinden aus Online- und Firmware-Tabelle, ihr Verlauf bleibt. Ganz entfernen: leere retained Nachricht auf its/<node>/status."
  },
  {
   "id": 7,
   "title": "Uptime",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "otm_node_uptime",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Zeit seit dem letzten Neustart des Empfängers (aus its/<node>/stats, jede Minute). Ein Sprung auf 0 ist ein Neustart, z. B. durch ein Update."
  },
  {
   "id": 8,
   "title": "MQTT-Nachrichten je Empfaenger pro Stunde (auch Nicht-ITS)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_mqtt[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Alle Frames, die die Bridge in der letzten Stunde gemeldet hat, auch solche ohne GeoNetworking (andere 802.11-Frames auf dem Kanal). Der Unterschied zu 'ITS-Frames je Empfänger' ist Beifang."
  },
  {
   "id": 9,
   "title": "Firmware je Empfaenger",
   "type": "table",
   "description": "Build-Nummer und Commit des Images ab otm-bridge 0.14.0; aeltere Staende melden nur Bridge-Version und Modell, und das nur beim Verbinden Klick auf den Namen: Graphen zu diesem Empfaenger (OTM Knoten).",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (node, version, commit, bridge, model) (last_over_time(otm_node_build[15m]))"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (node) (last_over_time(otm_node_online[15m]))"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "node",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Value #A": true
      },
      "indexByName": {
       "node": 0,
       "Value #B": 1,
       "version": 2,
       "commit": 3,
       "bridge": 4,
       "model": 5
      },
      "renameByName": {
       "node": "Empfaenger",
       "Value #B": "Status",
       "version": "Build",
       "commit": "Commit",
       "bridge": "otm-bridge",
       "model": "Modell"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Empfaenger"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "online",
            "color": "green",
            "index": 0
           },
           "0": {
            "text": "offline",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Empfaenger"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Graphen zu ${__value.text}",
          "url": "/d/otm-knoten/otm-knoten?var-node=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 10,
   "title": "Empfangs-Health (6 h)",
   "type": "table",
   "description": "Ab otm-bridge 0.16.0. Bewertung ueber die letzten 6 Stunden: 'empfaengt ITS' = mindestens ein ITS-Frame; 'nur Rauschen' = das Radio sieht Frames, CRC- oder PHY-Fehler, aber kein ITS (Standort ohne Verkehr?); 'taub?' = kein einziger Zaehler bewegt sich (so sah der NanoStation-Nachbau aus). CRC-Fehler: Praeambel erkannt, Inhalt kaputt. PHY-Fehler: Energie gesehen, nichts Dekodierbares. 'kein 5-GHz-Radio' = das Geraet hat kein Funkteil fuer 5.9 GHz (z. B. NanoStation M2 mit dem M-Image, Name dann NSM2..., ab otm-bridge 0.18.10); Einzelheiten in 'Geraete ohne Empfang'. Klick auf den Namen: Graphen zu diesem Empfaenger (OTM Knoten).",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "(clamp_max(sum by (node) (increase(otm_rx_pkts[6h]) + increase(otm_rx_crc[6h]) + increase(otm_rx_phy[6h])), 1) + (clamp_max(sum by (node) (increase(otm_frames[6h])), 1) or on(node) (sum by (node) (increase(otm_rx_pkts[6h]) + increase(otm_rx_crc[6h]) + increase(otm_rx_phy[6h])) * 0))) or on(node) (max by (node) (last_over_time(otm_node_problem[3h])) * -1)"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "sum by (node) (increase(otm_frames[6h]))"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "sum by (node) (increase(otm_rx_pkts[6h]))"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "sum by (node) (increase(otm_rx_crc[6h]))"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "sum by (node) (increase(otm_rx_phy[6h]))"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (node) (last_over_time(otm_rx_noise[15m]))"
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "100 * sum by (node) (increase(otm_rx_busy[6h])) / sum by (node) (increase(otm_rx_active[6h]))"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "node",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "Time 7": true
      },
      "indexByName": {
       "node": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "Value #E": 5,
       "Value #F": 6,
       "Value #G": 7
      },
      "renameByName": {
       "node": "Empfaenger",
       "Value #A": "Bewertung",
       "Value #B": "ITS-Frames",
       "Value #C": "Frames gesamt",
       "Value #D": "CRC-Fehler",
       "Value #E": "PHY-Fehler",
       "Value #F": "Rauschen (dBm)",
       "Value #G": "Kanal belegt (%)"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Empfaenger"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     },
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Bewertung"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "2": {
            "text": "empfaengt ITS",
            "color": "green",
            "index": 0
           },
           "1": {
            "text": "nur Rauschen",
            "color": "orange",
            "index": 1
           },
           "0": {
            "text": "taub?",
            "color": "red",
            "index": 2
           },
           "-1": {
            "text": "kein 5-GHz-Radio",
            "color": "purple",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Kanal belegt (%)"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Empfaenger"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Graphen zu ${__value.text}",
          "url": "/d/otm-knoten/otm-knoten?var-node=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 11,
   "title": "Geraete ohne Empfang",
   "type": "table",
   "description": "Ab otm-bridge 0.18.3. Geraete mit Tunnel, die gar nicht empfangen koennen und deshalb in den anderen Tabellen fehlen. 'no_its_radio' = kein Funkteil fuer 5.9 GHz; dahinter, was an Funkteilen da ist: 'phy0:2.4GHz' = nur 2.4 GHz (z. B. NanoStation M2 mit dem M5-Image, das fuer beide passt), 'none' = gar kein Funkteil erkannt (defekt?). Das Geraet meldet sich stuendlich; nach 3 h ohne Meldung faellt es heraus.",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 56,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (node, problem) (last_over_time(otm_node_problem[15m]))"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      },
      "indexByName": {
       "node": 0,
       "problem": 1
      },
      "renameByName": {
       "node": "Geraet",
       "problem": "Problem"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Geraet"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  }
 ],
 "tags": [
  "otm"
 ],
 "editable": true,
 "links": [
  {
   "title": "OTM Heatmap",
   "type": "link",
   "url": "/d/otm-heatmap",
   "icon": "dashboard"
  },
  {
   "title": "OTM Knoten",
   "type": "link",
   "url": "/d/otm-knoten",
   "icon": "dashboard",
   "keepTime": true
  }
 ]
}
