      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_exclusive[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {}
