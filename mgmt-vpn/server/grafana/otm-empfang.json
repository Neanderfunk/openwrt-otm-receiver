   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (n) (increase(otm_receivers_n[1h]))",
     "legendFormat": "{{n}} Empfaenger"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Anteil an allen Frames (24 h gleitend)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_frames[24h])) / scalar(sum(increase(otm_union_frames[24h])))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Verschiedene Absender je Minute",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
