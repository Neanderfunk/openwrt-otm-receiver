{
 "uid": "otm-empfang",
 "title": "OTM Empfang",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "ITS-Frames je Empfaenger pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_frames[1h]))",
     "legendFormat": "{{node}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_union_frames[1h]))",
     "legendFormat": "alle zusammen (verschiedene)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Nur von diesem Empfaenger gesehen, pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_exclusive[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Frames nach Zahl der Empfaenger, pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (n) (increase(otm_receivers_n[1h]))",
