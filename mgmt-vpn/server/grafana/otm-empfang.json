  {
   "id": 8,
   "title": "MQTT-Nachrichten je Empfaenger pro Stunde (auch Nicht-ITS)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_mqtt[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
