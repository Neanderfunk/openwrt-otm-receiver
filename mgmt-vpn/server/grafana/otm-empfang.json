{
 "uid": "otm-empfang",
 "title": "OTM Empfang",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "ITS-Frames je Empfaenger pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_frames[1h]))",
     "legendFormat": "{{node}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_union_frames[1h]))",
     "legendFormat": "alle zusammen (verschiedene)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Nur von diesem Empfaenger gesehen, pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_exclusive[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Frames nach Zahl der Empfaenger, pro Stunde",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (n) (increase(otm_receivers_n[1h]))",
     "legendFormat": "{{n}} Empfaenger"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Anteil an allen Frames (24 h gleitend)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_frames[24h])) / scalar(sum(increase(otm_union_frames[24h])))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Verschiedene Absender je Minute",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "otm_union_stations",
     "legendFormat": "Absender"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Online",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "otm_node_online",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Uptime",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "otm_node_uptime",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {}
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "MQTT-Nachrichten je Empfaenger pro Stunde (auch Nicht-ITS)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (node) (increase(otm_mqtt[1h]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Firmware je Empfaenger",
   "type": "table",
   "description": "Build-Nummer und Commit des Images ab otm-bridge 0.14.0; aeltere Staende melden nur Bridge-Version und Modell, und das nur beim Verbinden",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (node, version, commit, bridge, model) (last_over_time(otm_node_build[15m]))"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (node) (last_over_time(otm_node_online[15m]))"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "node",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Value #A": true
      },
      "indexByName": {
       "node": 0,
       "Value #B": 1,
       "version": 2,
       "commit": 3,
       "bridge": 4,
       "model": 5
      },
      "renameByName": {
       "node": "Empfaenger",
       "Value #B": "Status",
       "version": "Build",
       "commit": "Commit",
       "bridge": "otm-bridge",
       "model": "Modell"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Empfaenger"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "online",
            "color": "green",
            "index": 0
           },
           "0": {
            "text": "offline",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  }
 ],
 "tags": [
  "otm"
 ],
 "editable": true,
 "links": [
  {
   "title": "OTM Heatmap",
   "type": "link",
   "url": "/d/otm-heatmap",
   "icon": "dashboard"
  }
 ]
}