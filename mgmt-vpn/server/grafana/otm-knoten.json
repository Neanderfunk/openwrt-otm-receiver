    }
   }
  },
  {
   "id": 6,
   "title": "Anteil an allen Frames",
   "description": "Anteil dieses Empfaengers an allen verschiedenen Frames aller Empfaenger im Zeitraum.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_frames{node=\"$node\"}[$__range])) / sum(increase(otm_union_frames[$__range]))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 7,
   "title": "Empfangs-Health (6 h)",
   "description": "Ab otm-bridge 0.16.0. 'empfaengt ITS' = mindestens ein ITS-Frame in 6 Stunden; 'nur Rauschen' = das Radio sieht Frames oder Fehler, aber kein ITS; 'taub?' = kein Zaehler bewegt sich.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 18,
    "y": 4,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "clamp_max(sum((increase(otm_rx_pkts{node=\"$node\"}[6h]) + increase(otm_rx_crc{node=\"$node\"}[6h]) + increase(otm_rx_phy{node=\"$node\"}[6h]))), 1) + (clamp_max(sum(increase(otm_frames{node=\"$node\"}[6h])), 1) or sum((increase(otm_rx_pkts{node=\"$node\"}[6h]) + increase(otm_rx_crc{node=\"$node\"}[6h]) + increase(otm_rx_phy{node=\"$node\"}[6h]))) * 0)",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "2": {
         "text": "empfaengt ITS",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "nur Rauschen",
         "color": "orange",
         "index": 1
        },
        "0": {
         "text": "taub?",
         "color": "red",
         "index": 2
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 8,
   "title": "ITS-Frames pro Stunde",
   "description": "Frames dieses Empfaengers und davon die, die nur er hatte; zum Vergleich alle Empfaenger zusammen (jeder Frame einmal).",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_frames{node=\"$node\"}[1h]))",
     "legendFormat": "$node"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_exclusive{node=\"$node\"}[1h]))",
     "legendFormat": "nur $node"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_union_frames[1h]))",
     "legendFormat": "alle Empfaenger zusammen"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 1,
      "lineInterpolation": "linear",
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "title": "Funk-Zaehler pro Stunde",
   "description": "ath9k-Zaehler aus debugfs (otm/<node>/health): alle Frames, CRC-Fehler (Praeambel erkannt, Inhalt kaputt), PHY-Fehler (Energie gesehen, nichts Dekodierbares).",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
