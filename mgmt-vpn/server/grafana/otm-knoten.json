  {
   "id": 14,
   "title": "Heatmap: Absenderpositionen",
   "description": "Wo die Sender standen, deren Frames dieser Empfaenger im Zeitraum hatte (Position aus dem GeoNetworking-Header, Raster ~100 m). Blaues Dreieck: der Empfaenger selbst, wenn er seine Position teilt.",
   "type": "geomap",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (lat, lon) (increase(otm_pos{node=\"$node\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
