{
 "uid": "otm-knoten",
 "title": "OTM Knoten",
 "tags": [
  "otm"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "editable": true,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "graphTooltip": 1,
 "description": "Graphen zu einem einzelnen Empfaenger. Aufruf aus den Tabellen in OTM Empfang (Klick auf den Namen) oder mit ?var-node=<name>.",
 "links": [
  {
   "title": "OTM Empfang",
   "type": "link",
   "url": "/d/otm-empfang",
   "icon": "dashboard",
   "keepTime": true
  },
  {
   "title": "OTM Heatmap",
   "type": "link",
   "url": "/d/otm-heatmap",
   "icon": "dashboard",
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "node",
    "label": "Empfaenger",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "otm-vm"
    },
    "query": {
     "query": "label_values(otm_node_online, node)",
     "refId": "node"
    },
    "definition": "label_values(otm_node_online, node)",
    "refresh": 2,
    "sort": 1,
    "multi": false,
    "includeAll": false,
    "current": {},
    "options": []
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Firmware",
   "type": "table",
   "description": "Build-Nummer, Commit, otm-bridge und Modell, wie der Empfaenger sie zuletzt gemeldet hat (otm/<node>/build); alle Staende im gewaehlten Zeitraum, der hoechste oben.",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 14,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "1000 * max by (version, commit, bridge, model) (tlast_over_time(otm_node_build{node=\"$node\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "node": true,
       "__name__": true
      },
      "indexByName": {
       "version": 0,
       "commit": 1,
       "bridge": 2,
       "model": 3,
       "Value": 4
      },
      "renameByName": {
       "version": "Build",
       "commit": "Commit",
       "bridge": "otm-bridge",
       "model": "Modell",
       "Value": "zuletzt gemeldet"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Build",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "zuletzt gemeldet"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsLocal"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 2,
   "title": "Status",
   "description": "Zuletzt gemeldeter Zustand (retained Statusmeldung am Proxy, Last Will bei Verbindungsabbruch).",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "last_over_time(otm_node_online{node=\"$node\"}[7d])",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "online",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "offline",
         "color": "red",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "title": "Uptime",
   "description": "Zeit seit dem letzten Start des Empfaengers (its/<node>/stats, jede Minute).",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "last_over_time(otm_node_uptime{node=\"$node\"}[15m])",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "unit": "dtdurations"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 4,
   "title": "ITS-Frames im Zeitraum",
   "description": "ITS-G5-Frames (GeoNetworking), die dieser Empfaenger im oben gewaehlten Zeitraum gemeldet hat.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum(increase(otm_frames{node=\"$node\"}[$__range]))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 5,
   "title": "Nur hier gesehen",
   "description": "Frames im Zeitraum, die kein anderer unserer Empfaenger hatte. Zeigt, was dieser Standort zur Abdeckung beitraegt.",
   "type": "stat",
