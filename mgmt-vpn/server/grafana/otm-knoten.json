      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "title": "Rauschen",
   "description": "Grundrauschen des Kanals laut Survey des Treibers.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
