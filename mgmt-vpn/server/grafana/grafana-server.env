# an /etc/default/grafana-server angehaengt: nur lokal, nichts nach draussen
# nur IPv4; wer herein darf, regelt nft.conf (localhost und 192.168.18.0/24,
# dort steht der Proxy mit der oeffentlichen Adresse)
GF_SERVER_HTTP_ADDR=0.0.0.0
# oeffentlich unter otm.ffnef.de (TLS endet am Proxy davor)
GF_SERVER_DOMAIN=otm.ffnef.de
GF_SERVER_ROOT_URL=https://otm.ffnef.de/
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_ANALYTICS_FEEDBACK_LINKS_ENABLED=false
GF_NEWS_NEWS_FEED_ENABLED=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_USERS_ALLOW_SIGN_UP=false
