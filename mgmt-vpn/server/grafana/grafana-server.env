# an /etc/default/grafana-server angehaengt: nur lokal, nichts nach draussen
# nur IPv4; wer herein darf, regelt nft.conf (localhost und 192.168.18.0/24,
# dort steht der Proxy mit der oeffentlichen Adresse)
GF_SERVER_HTTP_ADDR=0.0.0.0
# oeffentlich unter otm.ffnef.de (TLS endet am Proxy davor)
GF_SERVER_DOMAIN=otm.ffnef.de
GF_SERVER_ROOT_URL=https://otm.ffnef.de/
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_ANALYTICS_FEEDBACK_LINKS_ENABLED=false
GF_NEWS_NEWS_FEED_ENABLED=false
# Lesen oeffentlich ohne Anmeldung (Rolle Viewer), Startseite = Dashboard
# OTM Empfang; Bearbeiten nur nach Login (Authentik, siehe unten)
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_AUTH_ANONYMOUS_HIDE_VERSION=true
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/otm/otm-empfang.json
GF_USERS_ALLOW_SIGN_UP=false
# Anmeldung ueber Authentik (idm.ffnef.de, Anwendung otm-ffnef-de). Gruppe
# "Freifunk" (Schreibweise wie in Authentik) wird Admin, alle anderen Viewer wie anonym. Das Client-Secret
# liegt nur auf dem Server in /etc/grafana/authentik-client-secret (root:grafana 640).
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=FFNEF ID
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=ihyS282cgapNSoL4mIfC0281MzDT512K294ZPZR9
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=$__file{/etc/grafana/authentik-client-secret}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://idm.ffnef.de/application/o/authorize/
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://idm.ffnef.de/application/o/token/
GF_AUTH_GENERIC_OAUTH_API_URL=https://idm.ffnef.de/application/o/userinfo/
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'Freifunk') && 'Admin' || 'Viewer'
GF_AUTH_SIGNOUT_REDIRECT_URL=https://idm.ffnef.de/application/o/otm-ffnef-de/end-session/
