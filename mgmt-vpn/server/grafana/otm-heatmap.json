  {
   "id": 6,
   "title": "Verkehrsmuster: Fahrzeuge je Minute (letzte 28 Tage)",
   "description": "Wie viele verschiedene Fahrzeuge die Empfaenger zusammen im Mittel pro Minute hoeren, nach Wochentag und Stunde (Ortszeit). Gemittelt ueber alle Minuten, in denen mindestens ein Empfaenger online war. Fahrzeug = Absender mit Stationstyp Fahrzeug; wechselt ein Fahrzeug seine Kennung (Pseudonym), zaehlt es kurz doppelt. Feste Zeitspanne 28 Tage, Daten ab 17.10.2026.",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "timeFrom": "28d",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (wd, h) (increase(otm_traffic_fz[$__range])) / sum by (wd, h) (increase(otm_traffic_min[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "h",
      "rowField": "wd",
      "valueField": "Value",
      "emptyValue": "null"
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "wd\\h": "Tag"
      },
      "indexByName": {
       "wd\\h": 0,
       "00": 1,
       "01": 2,
       "02": 3,
       "03": 4,
       "04": 5,
       "05": 6,
       "06": 7,
       "07": 8,
       "08": 9,
       "09": 10,
       "10": 11,
       "11": 12,
       "12": 13,
       "13": 14,
       "14": 15,
       "15": 16,
       "16": 17,
       "17": 18,
       "18": 19,
       "19": 20,
       "20": 21,
       "21": 22,
       "22": 23,
       "23": 24
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Tag"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 1,
     "color": {
      "mode": "continuous-GrYlRd"
     },
     "custom": {
      "align": "center",
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      },
      "width": 52
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
