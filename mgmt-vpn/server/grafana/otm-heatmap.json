{
 "uid": "otm-heatmap",
 "title": "OTM Heatmap",
 "tags": [
  "otm"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "editable": true,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "description": "Wo die empfangenen ITS-G5-Sender standen (Absenderposition aus dem GeoNetworking-Header, Raster ~100 m). Blaue Dreiecke: Empfaenger, die ihre Position teilen (share_location).",
 "links": [
  {
   "title": "OTM Empfang",
   "type": "link",
   "url": "/d/otm-empfang",
   "icon": "dashboard"
  },
  {
   "title": "OTM Knoten",
   "type": "link",
   "url": "/d/otm-knoten",
   "icon": "dashboard",
   "keepTime": true
  },
  {
   "title": "Heatmap je Empfaenger",
   "type": "link",
   "url": "/d/otm-heatmap-knoten",
   "icon": "dashboard",
   "keepTime": true
  }
 ],
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "Alle Empfaenger (verschiedene Frames)",
   "description": "Jeder Frame einmal gezaehlt, egal wie viele Empfaenger ihn hatten",
   "type": "geomap",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 16
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "sum by (lat, lon) (increase(otm_pos_union[$__range])) > 0",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "(max by (node, lat, lon) (last_over_time(otm_node_location[15m])) * on (node) sum by (node) (increase(otm_frames[$__range]))) or (max by (node, lat, lon) (last_over_time(otm_node_location[15m])) * 0)"
    }
   ],
   "transformations": [
    {
     "id": "convertFieldType",
     "options": {
      "fields": {},
      "conversions": [
       {
        "targetField": "lat",
        "destinationType": "number"
       },
       {
        "targetField": "lon",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-YlRd"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Value"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Frames"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "lat"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Breite"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "lon"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Länge"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "node"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Empfänger"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Value #A"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Frames"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Value #B"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Frames dieses Empfängers"
       }
      ]
     }
    ]
   },
   "options": {
    "view": {
     "id": "fit",
     "allLayers": true,
     "lat": 0,
     "lon": 0,
     "zoom": 14,
     "maxZoom": 17
