  {
   "id": 4,
   "title": "Durchschnittsgeschwindigkeit",
   "description": "Mittlere Geschwindigkeit aller Fahrzeug-Meldungen je Rasterzelle (~100 m) im Zeitraum, aus dem GeoNetworking-Header (jeder Frame einmal, auch wenn ihn mehrere Empfaenger hatten). Nur Fahrzeuge, keine Verkehrsinfrastruktur (RSU); stehende Fahrzeuge zaehlen mit 0 km/h, blau heisst also langsam oder Stau. Zellen mit weniger als 5 Meldungen bleiben weg. Daten ab 17.10.2026. Farben: blau unter 10, hellblau ab 10, gruen ab 30, gelb ab 50, orange ab 70, rot ab 100, magenta ab 130, dunkelviolett ab 160 km/h.",
   "type": "geomap",
   "datasource": {
    "type": "prometheus",
    "uid": "otm-vm"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "otm-vm"
     },
     "expr": "(sum by (lat, lon) (increase(otm_speed_sum[$__range])) / sum by (lat, lon) (increase(otm_speed_n[$__range]))) and on (lat, lon) (sum by (lat, lon) (increase(otm_speed_n[$__range])) >= 5)",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
