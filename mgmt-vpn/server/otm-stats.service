[Unit]
Description=Laufende Empfangsstatistik der OTM-Empfaenger nach VictoriaMetrics
After=mosquitto.service victoria-metrics.service
Wants=mosquitto.service victoria-metrics.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/otm/otm-stats.py
DynamicUser=yes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
