[Unit]
Description=Laufende Empfangsstatistik der OTM-Empfaenger nach VictoriaMetrics
After=mosquitto.service victoria-metrics.service
Wants=mosquitto.service victoria-metrics.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/otm/otm-stats.py
DynamicUser=yes
# namen.json (MAC -> Name), siehe Kopf von otm-stats.py
StateDirectory=otm-stats
# deleteAuthKey zum Umschreiben umbenannter Empfaenger; die Datei ist nur fuer root lesbar
LoadCredential=vm:/etc/default/victoria-metrics
# fremde Empfaenger "<name> <passwort>" je Zeile (root, 600); muss existieren (leer = nur lokal),
# sonst startet der Dienst nicht; install.sh legt sie leer an
LoadCredential=fremde:/etc/otm/fremde-empfaenger
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
